# Relative paths are resolved from the repository root.
DATABASE_PATH=.local/company_ops.sqlite
SQLITE_TIMEOUT_SECONDS=5

# Milestone 2 LLM settings. Set the selected provider's key and model in .env.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=45
